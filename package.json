{
  "name": "memories",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first, agent-agnostic memory for coding sessions",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "spike:f5": "node --experimental-strip-types --test-reporter=spec --test tests/runtime-f5.test.ts",
    "build": "tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "effect": "^3.0.0",
    "drizzle-orm": "^0.44.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0"
  }
}
